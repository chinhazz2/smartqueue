@startuml
left to right direction

skinparam packageStyle rectangle
skinparam shadowing false

actor Patient
actor Receptionist
actor Doctor
actor Administrator
actor "Notification Service" as NotificationService

rectangle SmartQueue {
    usecase "UC-01\nRegister patient" as UC01
    usecase "UC-02\nLogin" as UC02
    usecase "UC-03\nView available slots" as UC03
    usecase "UC-04\nBook appointment" as UC04
    usecase "UC-05\nCancel appointment" as UC05
    usecase "UC-06\nReschedule appointment" as UC06
    usecase "UC-07\nCheck in" as UC07
    usecase "UC-08\nCall next patient" as UC08
    usecase "UC-09\nComplete queue ticket" as UC09

    usecase "Manage users" as UC10
    usecase "Manage doctors" as UC11
    usecase "Manage doctor schedules" as UC12
    usecase "View audit log" as UC13

    usecase "Check slot availability" as IncludedSlot
    usecase "Create queue ticket" as IncludedTicket
    usecase "Select earliest waiting ticket" as IncludedNext
    usecase "Send status notification" as ExtendedNotification
}

Patient --> UC01
Patient --> UC02
Patient --> UC03
Patient --> UC04
Patient --> UC05
Patient --> UC06
Patient --> UC07

Receptionist --> UC02
Receptionist --> UC03
Receptionist --> UC04
Receptionist --> UC05
Receptionist --> UC06
Receptionist --> UC07

Doctor --> UC02
Doctor --> UC08
Doctor --> UC09

Administrator --> UC02
Administrator --> UC10
Administrator --> UC11
Administrator --> UC12
Administrator --> UC13

UC04 .> IncludedSlot : <<include>>
UC06 .> IncludedSlot : <<include>>
UC07 .> IncludedTicket : <<include>>
UC08 .> IncludedNext : <<include>>

ExtendedNotification .> UC04 : <<extend>>
ExtendedNotification .> UC05 : <<extend>>
ExtendedNotification .> UC07 : <<extend>>

NotificationService --> ExtendedNotification

@enduml